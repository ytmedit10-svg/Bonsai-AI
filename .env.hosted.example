# Hosted/API-backed setup. Copy to .env and replace placeholders.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
ATTACHMENT_STORAGE_PROVIDER=r2
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=your-r2-bucket
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_AVAILABLE_MODELS=gemma-4-26b-a4b-it,gemma-4-31b-it
GEMINI_DEFAULT_MODEL=gemma-4-26b-a4b-it
GEMINI_MERGE_MODEL=gemma-4-26b-a4b-it
DEV_BOOTSTRAP_USER_EMAIL=demo@nodebasedchat.local
DEV_BOOTSTRAP_USER_NAME=Demo User
MIN_EXPLICIT_CACHE_TOKENS=2048
DEFAULT_SPLIT_SNAPSHOT_TTL_SECONDS=3600
DEFAULT_DOC_CACHE_TTL_SECONDS=21600
COMPACTION_TRIGGER_MESSAGES=32
COMPACTION_KEEP_RECENT_MESSAGES=12
COMPACTION_MAX_SOURCE_MESSAGES=80
CONTEXT_MAX_ESTIMATED_TOKENS=100000
CONTEXT_MAX_MERGE_MEMORIES=3
CONTEXT_MAX_RETRIEVAL_CANDIDATES=4
EMBEDDING_MODEL=local-hash-embedding-v1
EMBEDDING_DIMENSIONS=64
JOB_LOCK_TIMEOUT_SECONDS=300
JOB_MAINTENANCE_INTERVAL_SECONDS=300
JOB_POLL_INTERVAL_MS=3000
MAX_RECENT_MESSAGES_PER_PATH=24
ENABLE_EXPLICIT_CACHE=true
# Hosted containers should bind on all interfaces. Omit API_PORT on platforms
# that provide PORT, such as Railway.
API_HOST=0.0.0.0
# API_PORT=4000
API_ADMIN_KEY=change-me-admin-key
VITE_API_BASE_URL=http://127.0.0.1:4000
VITE_AI_DEFAULT_MODEL=gemma-4-26b-a4b-it
VITE_ENABLE_ADMIN_UI=true
COST_INPUT_USD_PER_MTOKENS=0
COST_OUTPUT_USD_PER_MTOKENS=0
